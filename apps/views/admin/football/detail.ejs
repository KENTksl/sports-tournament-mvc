        // Events logic
        function getActivePlayers(side) {
            const lineupKey = side === 'team1' ? 'lineup1' : 'lineup2';
            const teamName = side === 'team1' ? currentMatch.team1 : currentMatch.team2;
            const team = tournamentData.teams.find(t => t.name === teamName);
            const members = team ? (team.members || []) : [];
            const ids = (currentMatch[lineupKey] || []).filter(Boolean);
            return members.filter(m => ids.includes(m.id) || ids.includes(m.name));
        }

        function getBenchPlayers(side) {
            const teamName = side === 'team1' ? currentMatch.team1 : currentMatch.team2;
            const team = tournamentData.teams.find(t => t.name === teamName);
            const members = team ? (team.members || []) : [];
            const active = getActivePlayers(side);
            const activeIds = new Set(active.map(m => m.id));
            return members.filter(m => !activeIds.has(m.id));
        }

        function updateEventForm() {
            const side = document.getElementById('eventTeamSelect').value;
            const type = document.getElementById('eventTypeSelect').value;
            const playerSelect = document.getElementById('eventPlayerSelect');
            const assistSelect = document.getElementById('assistPlayerSelect');
            const assistContainer = document.getElementById('assistContainer');

            const active = getActivePlayers(side);
            const bench = getBenchPlayers(side);

            let selectable = active;
            if (type === 'yellow' || type === 'red') {
                selectable = active.concat(bench);
            }

            // Filter out players who are sent off (Red card or 2 Yellows)
            selectable = selectable.filter(p => {
                const status = getPlayerDisciplinaryStatus(p, side);
                return !status.sentOff;
            });

            playerSelect.innerHTML = selectable.map(p => `<option value="${p.id || p.name}">${p.name}</option>`).join('');

            if (type === 'goal') {
                assistContainer.style.display = '';
                // Filter assist candidates: must not be sent off, and not the scorer
                let assistCandidates = active.filter(p => {
                    const status = getPlayerDisciplinaryStatus(p, side);
                    return !status.sentOff && (p.id || p.name) !== playerSelect.value;
                });
                
                const options = [`<option value="">Không</option>`].concat(
                    assistCandidates.map(p => `<option value="${p.id || p.name}">${p.name}</option>`)
                );
                assistSelect.innerHTML = options.join('');
            } else {
                assistContainer.style.display = 'none';
                assistSelect.innerHTML = '';
            }
        }

        document.getElementById('eventTeamSelect').addEventListener('change', updateEventForm);
        document.getElementById('eventTypeSelect').addEventListener('change', updateEventForm);
        document.getElementById('eventPlayerSelect').addEventListener('change', function(){
            const type = document.getElementById('eventTypeSelect').value;
            if (type !== 'goal') return;
            const side = document.getElementById('eventTeamSelect').value;
            const active = getActivePlayers(side);
            const playerId = document.getElementById('eventPlayerSelect').value;
            const assistSelect = document.getElementById('assistPlayerSelect');
            
            // Filter assist candidates on player change too
            let assistCandidates = active.filter(p => {
                const status = getPlayerDisciplinaryStatus(p, side);
                return !status.sentOff && String(p.id || p.name) !== String(playerId);
            });

            assistSelect.innerHTML = [`<option value="">Không</option>`].concat(
                assistCandidates.map(p => `<option value="${p.id || p.name}">${p.name}</option>`)
            ).join('');
        });

        function addEvent() {
            if (!currentMatch.events) currentMatch.events = [];
            const minute = currentMatch.clock && typeof currentMatch.clock.displayMinute === 'number' ? currentMatch.clock.displayMinute : parseInt(document.getElementById('eventMinute').value || '0');
            const side = document.getElementById('eventTeamSelect').value;
            const type = document.getElementById('eventTypeSelect').value;
            const playerId = document.getElementById('eventPlayerSelect').value;
            const assistRaw = document.getElementById('assistPlayerSelect').value;
            const assistId = assistRaw === '' ? null : assistRaw;

            const teamName = side === 'team1' ? currentMatch.team1 : currentMatch.team2;
            const team = tournamentData.teams.find(t => t.name === teamName);
            const members = team ? (team.members || []) : [];
            const player = members.find(m => String(m.id) === String(playerId) || m.name === playerId);
            const assist = members.find(m => String(m.id) === String(assistId) || m.name === assistId);

            // Validation: Check if player is sent off before this minute
            if (player && (type === 'goal' || type === 'yellow' || type === 'red' || assist)) {
                 let redCardMinute = -1;
                 let yellowCount = 0;
                 let secondYellowMinute = -1;
                 
                 currentMatch.events.forEach(ev => {
                    let isTarget = false;
                    if (ev.playerId && player.id && String(ev.playerId) === String(player.id)) isTarget = true;
                    else if (ev.playerName === player.name && (!ev.playerId || !player.id)) isTarget = true;
                    
                    if (isTarget) {
                        if (ev.type === 'red') {
                             if (redCardMinute === -1 || ev.minute < redCardMinute) redCardMinute = ev.minute;
                        }
                        if (ev.type === 'yellow') {
                            yellowCount++;
                            if (yellowCount === 2) {
                                secondYellowMinute = ev.minute;
                            }
                        }
                    }
                 });
                 
                 const sentOffTime = (redCardMinute !== -1) ? redCardMinute : (secondYellowMinute !== -1 ? secondYellowMinute : -1);
                 
                 if (sentOffTime !== -1 && minute > sentOffTime) {
                     Swal.fire({
                        icon: 'error',
                        title: 'Lỗi hợp lệ',
                        text: `Cầu thủ này đã bị đuổi khỏi sân ở phút ${sentOffTime}. Không thể thêm sự kiện sau thời điểm đó.`
                     });
                     return;
                 }
            }

            const ev = {
                id: Date.now() + '_' + Math.random().toString(36).substr(2,5),
                minute,
                team: side,
                teamName,
                playerId: player ? player.id : null,
                playerName: player ? player.name : 'N/A',
                type,
                assistId: assist ? assist.id : null,
                assistName: assist ? assist.name : ''
            };

            currentMatch.events.push(ev);

            // --- RED CARD RULE: Auto-remove from field ---
            if (player) {
                 const status = getPlayerDisciplinaryStatus(player, side);
                 if (status.sentOff) {
                     const lineupKey = side === 'team1' ? 'lineup1' : 'lineup2';
                     if (currentMatch[lineupKey]) {
                         const idx = currentMatch[lineupKey].findIndex(pid => (pid && (String(pid) === String(player.id) || pid === player.name)));
                         if (idx !== -1) {
                             currentMatch[lineupKey][idx] = null;
                             startPenalty(side, idx);
                             // Optional: Notify user
                             // Swal.fire({ title: 'Thẻ đỏ', text: 'Cầu thủ đã bị rời sân.', icon: 'warning', timer: 1500, showConfirmButton: false });
                         }
                     }
                 }
            }
            // ---------------------------------------------

            if (type === 'goal') {
                const other = side === 'team1' ? 'team2' : 'team1';
                const p = currentMatch.penalties && currentMatch.penalties[other];
                if (p && p.active) {
                    endPenalty(other, 'opponent_goal');
                }
            }

            renderEvents();
            recomputeScoreFromEvents();
            renderTeamLineup('team1', currentMatch.team1, currentMatch.lineup1 || [], PITCH_CONFIGS[tournamentData.pitchType || '7'] || PITCH_CONFIGS['7']);
            renderTeamLineup('team2', currentMatch.team2, currentMatch.lineup2 || [], PITCH_CONFIGS[tournamentData.pitchType || '7'] || PITCH_CONFIGS['7']);
        }

        function renderEvents() {
            const body = document.getElementById('eventListBody');
            body.innerHTML = '';
            if (!currentMatch.events || currentMatch.events.length === 0) {
                body.innerHTML = '<tr class="text-center text-muted"><td colspan="6">Chưa có diễn biến nào</td></tr>';
                return;
            }
            currentMatch.events.sort((a,b)=>a.minute-b.minute).forEach(ev=>{
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-center">${ev.minute}</td>
                    <td>${ev.team === 'team1' ? currentMatch.team1 : currentMatch.team2}</td>
                    <td>${ev.playerName}</td>
                    <td class="text-center">${ev.type === 'goal' ? 'Bàn thắng' : ev.type === 'yellow' ? 'Thẻ vàng' : 'Thẻ đỏ'}</td>
                    <td>${ev.assistName || ''}</td>
                    <td class="text-center"><button class="btn btn-sm btn-outline-danger" onclick="removeEvent('${ev.id}')"><i class="fa fa-trash"></i></button></td>
                `;
                body.appendChild(tr);
            });
        }

        function removeEvent(id) {
            if (!currentMatch.events) return;
            currentMatch.events = currentMatch.events.filter(e => e.id !== id);
            renderEvents();
            recomputeScoreFromEvents();
            renderTeamLineup('team1', currentMatch.team1, currentMatch.lineup1 || [], PITCH_CONFIGS[tournamentData.pitchType || '7'] || PITCH_CONFIGS['7']);
            renderTeamLineup('team2', currentMatch.team2, currentMatch.lineup2 || [], PITCH_CONFIGS[tournamentData.pitchType || '7'] || PITCH_CONFIGS['7']);
        }

        function recomputeScoreFromEvents() {
            let s1 = 0, s2 = 0;
            (currentMatch.events || []).forEach(ev=>{
                if (ev.type === 'goal') {
                    if (ev.team === 'team1') s1++; else s2++;
                }
            });
            document.getElementById('matchScore1').value = s1;
            document.getElementById('matchScore2').value = s2;
        }

        function getPlayerDisciplinaryStatus(player, side) {
            const events = currentMatch && currentMatch.events ? currentMatch.events : [];
            let yellow = 0, red = 0;
            events.forEach(ev => {
                if (ev.team !== side) return;

                let isTarget = false;
                // Robust check: ID match OR (Name match AND (No ID in event OR No ID in player))
                if (ev.playerId && player.id && String(ev.playerId) === String(player.id)) {
                    isTarget = true;
                } else if (ev.playerName === player.name) {
                    // Fallback to name if one side lacks ID
                    if (!ev.playerId || !player.id) isTarget = true;
                }

                if (isTarget) {
                    if (ev.type === 'yellow') yellow++;
                    if (ev.type === 'red') red++;
                }
            });
            const sentOff = red >= 1 || yellow >= 2;
            // Determine sent-off minute (first red or second yellow)
            let sentOffMinute = null;
            if (sentOff) {
                let yCount = 0, secondYellowMinute = null, firstRedMinute = null;
                events.forEach(ev=>{
                    if (ev.team !== side) return;
                    
                    if ((ev.playerId && player.id && String(ev.playerId) === String(player.id)) ||
                        (ev.playerName === player.name && (!ev.playerId || !player.id))) {
                        if (ev.type === 'yellow') {
                            yCount++;
                            if (yCount === 2 && secondYellowMinute === null) secondYellowMinute = ev.minute;
                        }
                        if (ev.type === 'red' && firstRedMinute === null) firstRedMinute = ev.minute;
                    }
                });
                sentOffMinute = firstRedMinute !== null ? firstRedMinute : secondYellowMinute;
            }
            return { yellow, red, sentOff, sentOffMinute };
        }

        // Penalty countdown management (2 minutes) per side
        function startPenalty(side, slotIndex) {
            if (!currentMatch.penalties) currentMatch.penalties = {};
            currentMatch.penalties[side] = {
                active: true,
                slotIndex,
                startedAt: Date.now(),
                endsAt: Date.now() + 120000
            };
        }

        function endPenalty(side, reason) {
            if (!currentMatch.penalties || !currentMatch.penalties[side]) return;
            currentMatch.penalties[side].active = false;
            const idx = currentMatch.penalties[side].slotIndex;
            const el = document.getElementById(`penalty-timer-${side}-${idx}`);
            if (el) el.remove();
            let msg = 'Đã hết thời gian phạt, được phép bổ sung người.';
            if (reason === 'opponent_goal') msg = 'Đối thủ vừa ghi bàn, được phép bổ sung người ngay.';
            Swal.fire({
                icon: 'info',
                title: 'Bổ sung người',
                text: msg,
                timer: 2000,
                showConfirmButton: false
            });
            const pitchType = tournamentData.pitchType || '7';
            const positions = PITCH_CONFIGS[pitchType] || PITCH_CONFIGS['7'];
            const teamName = side === 'team1' ? currentMatch.team1 : currentMatch.team2;
            const lineup = side === 'team1' ? (currentMatch.lineup1 || []) : (currentMatch.lineup2 || []);
            renderTeamLineup(side, teamName, lineup, positions);
        }

        function updatePenaltyCountdown() {
            if (!currentMatch || !currentMatch.penalties) return;
            ['team1','team2'].forEach(side=>{
                const p = currentMatch.penalties[side];
                if (!p || !p.active) return;
                const remaining = Math.max(0, p.endsAt - Date.now());
                const mm = String(Math.floor(remaining / 60000)).padStart(2,'0');
                const ss = String(Math.floor((remaining % 60000)/1000)).padStart(2,'0');
                const timerEl = document.getElementById(`penalty-timer-${side}-${p.slotIndex}`);
                if (timerEl) timerEl.textContent = `${mm}:${ss}`;
                if (remaining <= 0) {
                    endPenalty(side, 'time_up');
                }
            });
        }

        function getPlayerEventStats(player, side) {
            const events = currentMatch && currentMatch.events ? currentMatch.events : [];
            let goals = 0, assists = 0;
            events.forEach(ev => {
                if (ev.team !== side) return;

                let isTarget = false;
                // Robust check: ID match OR (Name match AND (No ID in event OR No ID in player))
                if (ev.playerId && player.id && String(ev.playerId) === String(player.id)) {
                    isTarget = true;
                } else if (ev.playerName === player.name) {
                    // Fallback to name if one side lacks ID
                    if (!ev.playerId || !player.id) isTarget = true;
                }

                if (isTarget) {
                    if (ev.type === 'goal') goals++;
                }

                // Assist check
                let isAssist = false;
                if (ev.assistId && player.id && String(ev.assistId) === String(player.id)) {
                    isAssist = true;
                } else if (ev.assistName === player.name) {
                     if (!ev.assistId || !player.id) isAssist = true;
                }

                if (isAssist && ev.type === 'goal') {
                    assists++;
                }
            });
            return { goals, assists };
        }

        // Lấy danh sách cầu thủ bị cấm thi đấu ở trận hiện tại
        function getSuspendedPlayerIdsForCurrentMatch(teamName) {
            if (!tournamentData || !tournamentData.fixtures || !currentMatch) return [];
            const teamMatches = [];
            tournamentData.fixtures.forEach(group => {
                (group.matches || []).forEach(m => {
                    if (m.team1 === teamName || m.team2 === teamName) {
                        teamMatches.push(m);
                    }
                });
            });
            const idx = teamMatches.findIndex(m => m.id === currentMatch.id);
            if (idx <= 0) return [];
            const prev = teamMatches[idx - 1];
            const suspended = [];
            
            // Map to track yellow cards per player in previous match
            const yellowCounts = {};

            (prev.events || []).forEach(ev => {
                const evTeamName = ev.teamName || (ev.team === 'team1' ? prev.team1 : prev.team2);
                if (evTeamName !== teamName) return;

                const pKey = ev.playerId ? String(ev.playerId) : ev.playerName;
                if (!pKey) return;

                if (ev.type === 'red') {
                    suspended.push(pKey);
                } else if (ev.type === 'yellow') {
                    if (!yellowCounts[pKey]) yellowCounts[pKey] = 0;
                    yellowCounts[pKey]++;
                    if (yellowCounts[pKey] >= 2) {
                        suspended.push(pKey);
                    }
                }
            });
            return suspended;
        }

        // Initialize event form when modal opens
        document.getElementById('matchDetailModal').addEventListener('shown.bs.modal', function(){
            document.getElementById('eventTeamSelect').value = 'team1';
            document.getElementById('eventTypeSelect').value = 'goal';
            const teamSelect = document.getElementById('eventTeamSelect');
            teamSelect.options[0].text = currentMatch.team1;
            teamSelect.options[1].text = currentMatch.team2;
            updateEventForm();
            renderEvents();

            // Sync score from events if goals exist (to fix 0-0 display issue)
            let s1 = 0, s2 = 0;
            let hasGoals = false;
            (currentMatch.events || []).forEach(ev=>{
                if (ev.type === 'goal') {
                    hasGoals = true;
                    if (ev.team === 'team1') s1++; else s2++;
                }
            });
            if (hasGoals) {
                document.getElementById('matchScore1').value = s1;
                document.getElementById('matchScore2').value = s2;
            }
        });

        document.getElementById('matchDetailModal').addEventListener('hidden.bs.modal', function(){
            // Defensive cleanup to avoid dimmed overlay staying
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('padding-right');
            document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
            matchModalInstance && matchModalInstance.dispose && matchModalInstance.dispose();
            matchModalInstance = null;
            if (penaltyInterval) {
                clearInterval(penaltyInterval);
                penaltyInterval = null;
            }
            if (matchClockInterval) {
                clearInterval(matchClockInterval);
                matchClockInterval = null;
            }
            if (kickoffTimeoutId) {
                clearTimeout(kickoffTimeoutId);
                kickoffTimeoutId = null;
            }
            if (scheduleCheckInterval) {
                clearInterval(scheduleCheckInterval);
                scheduleCheckInterval = null;
            }
        });

        async function validateSchedule() {
            if (!currentMatch) return;
            const date = document.getElementById('matchDate').value;
            const time = document.getElementById('matchTime').value;
            const location = document.getElementById('matchLocation').value;
            const msgDiv = document.getElementById('scheduleValidationMsg');
            
            if (!date || !time) {
                msgDiv.style.display = 'none';
                return;
            }

            try {
                const res = await fetch('/admin/football/tournament/validate-match', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        tournamentId: tournamentData._id,
                        matchId: currentMatch.id,
                        date, time, location
                    })
                });
                const data = await res.json();
                if (!data.valid) {
                    msgDiv.innerHTML = `
                        <div class="alert alert-warning d-flex align-items-center mb-0" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            <div>
                                <strong>Cảnh báo xung đột:</strong> ${data.message}
                            </div>
                        </div>
                    `;
                    msgDiv.style.display = 'block';
                } else {
                    msgDiv.style.display = 'none';
                }
            } catch (e) {
                console.error(e);
            }
            autoStartClockIfDue();
            scheduleAutoKickoff();
        }

        function saveMatchSchedule() {
            if (!currentMatch) return;
            const date = document.getElementById('matchDate').value;
            const time = document.getElementById('matchTime').value;
            const location = document.getElementById('matchLocation').value;

            // Simple client-side check
            if (document.getElementById('scheduleValidationMsg').style.display === 'block') {
                Swal.fire({
                    title: 'Cảnh báo xung đột lịch',
                    text: "Lịch thi đấu đang có cảnh báo xung đột. Bạn có chắc chắn muốn lưu?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Vẫn lưu',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        performSaveSchedule(date, time, location);
                    }
                });
                return;
            }
            
            performSaveSchedule(date, time, location);
        }

        function performSaveSchedule(date, time, location) {
            const btn = document.querySelector('#matchDetailModal .btn-info');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Đang lưu...';

            const score1Val = document.getElementById('matchScore1').value;
            const score2Val = document.getElementById('matchScore2').value;

            const data = {
                tournamentId: tournamentData._id,
                matchId: currentMatch.id,
                date, time, location,
                score1: score1Val,
                score2: score2Val
            };

            fetch('/admin/football/tournament/update-match', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    currentMatch.date = date;
                    currentMatch.time = time;
                    currentMatch.location = location;
                    currentMatch.score1 = (score1Val === '') ? null : parseInt(score1Val);
                    currentMatch.score2 = (score2Val === '') ? null : parseInt(score2Val);
                    
                    // Update list row
                    if (tournamentData.fixtures) {
                        for (const group of tournamentData.fixtures) {
                            const m = group.matches.find(m => m.id === currentMatch.id);
                            if (m) {
                                m.date = date;
                                m.time = time;
                                m.location = location;
                                m.score1 = (score1Val === '') ? null : parseInt(score1Val);
                                m.score2 = (score2Val === '') ? null : parseInt(score2Val);
                            }
                        }
                    }
                    // Find row to update text
                    const triggerBtn = document.querySelector(`[data-match-id="${currentMatch.id}"]`);
                    if (triggerBtn) {
                        const row = triggerBtn.closest('tr');
                        if (row) {
                            const dateCell = row.cells[0];
                            if (dateCell) {
                                dateCell.innerHTML = `${date} <br><small class="text-muted">${time}</small>`;
                            }
                            // Update score cell immediately
                            const scoreCell = row.querySelector('td.text-center');
                            if (scoreCell) {
                                const s1 = (currentMatch.score1 === null || currentMatch.score1 === undefined) ? '- -' : currentMatch.score1;
                                const s2 = (currentMatch.score2 === null || currentMatch.score2 === undefined) ? '' : currentMatch.score2;
                                scoreCell.innerHTML = (s1 === '- -') ? '- : -' : `${s1} : ${s2}`;
                            }
                        }
                    }
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: 'Đã lưu lịch thi đấu.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    autoStartClockIfDue();
                    scheduleAutoKickoff();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: res.message
                    });
                }
            })
            .catch(err => {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: err.message
                });
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = originalText;
            });
        }

        function submitAddTeam(event) {
            event.preventDefault();
            const form = event.target;
            const formData = new FormData(form);
            const errDiv = document.getElementById('addTeamError');
            const btn = form.querySelector('button[type="submit"]');
            
            btn.disabled = true;
            errDiv.classList.add('d-none');

            fetch('/admin/football/tournament/add-team', {
                method: 'POST',
                body: formData
            })
            .then(res => {
                if (res.redirected) {
                    window.location.href = res.url;
                    return;
                }
                return res.json().catch(() => ({ message: res.statusText }));
            })
            .then(data => {
                if (data && !data.success && data.message) {
                    errDiv.innerText = data.message;
                    errDiv.classList.remove('d-none');
                    btn.disabled = false;
                } else if (data && data.success) {
                     window.location.reload();
                }
            })
            .catch(err => {
                console.error(err);
                // If it was a redirect but failed to parse JSON, it might have actually succeeded if we rely on redirect.
                // But here we expect JSON on error or redirect on success.
                // If fetch followed redirect, we handled it.
                // If backend sent HTML error, we might be here.
                errDiv.innerText = 'Lỗi: ' + err.message;
                errDiv.classList.remove('d-none');
                btn.disabled = false;
            });
        }

       function checkPlayerEligibility(input) {
            const citizenId = input.value;
            const form = input.closest('form');
            const tournamentId = form.querySelector('input[name="tournamentId"]').value;
            const nameInput = form.querySelector('input[name="memberName"]');
            const msgDiv = form.querySelector('.eligibility-msg');
            const btn = form.querySelector('button[type="submit"]');

            if (!citizenId) return;

            // Reset UI
            msgDiv.style.display = 'none';
            input.classList.remove('is-invalid', 'is-valid');
            btn.disabled = true;

            fetch('/admin/football/tournament/check-player', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tournamentId: tournamentId,
                    citizenId: citizenId,
                    memberName: nameInput.value
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.valid) {
                    input.classList.add('is-valid');
                    btn.disabled = false;
                } else {
                    input.classList.add('is-invalid');
                    // Use SweetAlert for notification instead of inline text
                    Swal.fire({
                        icon: 'warning',
                        title: 'Cảnh báo trùng lặp',
                        text: data.message,
                        confirmButtonText: 'Đã hiểu'
                    });
                    // Hide the inline message div just in case
                    msgDiv.style.display = 'none';
                    // Keep button disabled
                }
            })
            .catch(err => {
                console.error(err);
                btn.disabled = false; // Allow retry or ignore if network error
            });
        }

        async function submitAddMember(event, form) {
            event.preventDefault();
            const teamId = form.getAttribute('data-team-id');
            const formData = new FormData(form);
            const errDiv = form.querySelector('.member-error-msg');
            const btn = form.querySelector('button'); // The 'Thêm' button inside form is technically type=button in original HTML?
            // Wait, in my updated HTML I didn't change the button type to submit?
            // If I used onsubmit, I need a submit button.
            // Let's assume the user clicks enter or I change button type.
            // Actually, the original button was type="button" with onclick.
            // I should check if I changed the button type.
            
            // Re-selecting button
            const submitBtn = form.querySelector('button[onclick]'); 
            if (submitBtn) {
                 // It was the button with onclick. 
            }
            
            if (!teamId) return;

            const memberNameInput = form.querySelector('input[name="memberName"]');
            if (!memberNameInput || !memberNameInput.value.trim()) {
                alert('Vui lòng nhập tên thành viên!');
                if(memberNameInput) memberNameInput.focus();
                return;
            }

            if (errDiv) errDiv.classList.add('d-none');
            // Show loading state
            // ... (simplify for brevity)
            
            fetch('/admin/football/tournament/add-team-member', {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body: formData
            })
            .then(res => {
                 const contentType = res.headers.get("content-type");
                 if (contentType && contentType.indexOf("application/json") !== -1) {
                     return res.json();
                 } else {
                     return res.text().then(text => {
                         throw new Error('Server returned non-JSON response: ' + text.substring(0, 100));
                     });
                 }
            })
            .then(data => {
                if (data.success) {
                    // Success logic (same as before)
                    form.querySelector('input[name="memberName"]').value = '';
                    form.querySelector('input[name="memberAvatar"]').value = '';
                    
                    const list = document.getElementById(`member-list-${teamId}`);
                    const countSpan = document.getElementById(`member-count-${teamId}`);
                    
                    // Remove "no members" if exists
                    const emptyMsg = list.querySelector('.text-muted');
                    let index = 1;
                    if (emptyMsg) {
                        emptyMsg.remove();
                    } else {
                        index = list.children.length + 1;
                    }
                    
                    const member = data.member;
                    const li = document.createElement('li');
                    li.className = 'list-group-item d-flex justify-content-between align-items-center';
                    li.innerHTML = `
                        <div class="d-flex align-items-center">
                            <span class="fw-bold me-3">${index}.</span>
                            ${member.avatar && member.avatar !== 'default-avatar.png' ? 
                                `<img src="/static/uploads/tournaments/${member.avatar}" class="rounded-circle me-2" width="30" height="30">` : 
                                `<div class="bg-secondary rounded-circle me-2 d-flex align-items-center justify-content-center text-white" style="width: 30px; height: 30px;"><i class="fa fa-user"></i></div>`
                            }
                            <span>${member.name}</span>
                        </div>
                    `;
                    list.appendChild(li);
                    if (countSpan) countSpan.innerText = parseInt(countSpan.innerText) + 1;
                    memberNameInput.focus();

                    Swal.fire({
                        icon: 'success',
                        title: 'Đã thêm thành viên',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000
                    });
                } else {
                    if (errDiv) {
                        errDiv.innerText = data.message;
                        errDiv.classList.remove('d-none');
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message
                        });
                    }
                }
            })
            .catch(err => {
                if (errDiv) {
                    errDiv.innerText = err.message;
                    errDiv.classList.remove('d-none');
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi kết nối',
                        text: err.message
                    });
                }
            });
        }

        function deleteTeam(teamId, btnEl) {
            if (!teamId) return;
            Swal.fire({
                title: 'Xóa đội?',
                text: 'Hành động này sẽ xóa đội khỏi giải. Bạn có chắc chắn?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (!result.isConfirmed) return;
                fetch('/admin/football/tournament/delete-team', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tournamentId: tournamentData._id, teamId })
                }).then(res => res.json())
                .then(data => {
                    if (data && data.success) {
                        // Update local state
                        if (tournamentData.teams && tournamentData.teams.length) {
                            tournamentData.teams = tournamentData.teams.filter(t => String(t.id) !== String(teamId) && String(t._id) !== String(teamId));
                        }
                        // Remove row in UI
                        if (btnEl) {
                            const row = btnEl.closest('tr');
                            if (row) row.remove();
                        }
                        Swal.fire({ icon: 'success', title: 'Đã xóa đội', timer: 1500, showConfirmButton: false });
                    } else {
                        const msg = (data && data.message) ? data.message : 'Không thể xóa đội';
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: msg });
                    }
                }).catch(err => {
                    Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: err.message });
                });
            });
        }

    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            let data = (tournamentData && tournamentData.bracketData) ? tournamentData.bracketData : null;
            const ready = !!(data && data.teams && data.results && window.jQuery && $.fn && $.fn.bracket);
            function render(){ if (!ready) return; $('#bracket-container').empty().bracket({ init: data }); }
            document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(function(btn){
                btn.addEventListener('shown.bs.tab', function(e){ if (e.target.id === 'bracket-tab') render(); });
            });
            if (document.getElementById('bracket') && document.getElementById('bracket').classList.contains('show')) render();
            if (!ready) {
                const msg = (!$.fn || !$.fn.bracket) ? 'Thiếu thư viện bracket.' : 'Chưa có dữ liệu sơ đồ.';
                const el = document.getElementById('bracket-container');
                if (el && !el.innerHTML.trim()) el.innerHTML = '<p class="text-muted">' + msg + '</p>';
            }
        });

        // Calendar Integration
        document.addEventListener('DOMContentLoaded', function() {
            const calendarEl = document.getElementById('calendar');
            const calendarTab = document.getElementById('calendar-view-tab');
            let calendar = null;

            if (calendarEl) {
                // Collect events from tournament data
                let events = [];
                if (tournamentData.fixtures) {
                    tournamentData.fixtures.forEach(group => {
                        if (group.matches) {
                            group.matches.forEach(m => {
                                if (m.date && m.time) {
                                    // Combine date and time
                                    let dt = parseMatchDateTime(m.date, m.time);
                                    if (dt) {
                                        events.push({
                                            title: `${m.team1} vs ${m.team2} (${group.group})`,
                                            start: dt,
                                            // end: dt + duration (90 mins usually)
                                            end: new Date(dt.getTime() + 90*60000),
                                            color: (m.score1!==null && m.score2!==null) ? '#28a745' : '#ffc107',
                                            textColor: (m.score1!==null && m.score2!==null) ? '#fff' : '#000',
                                            extendedProps: {
                                                matchId: m.id,
                                                group: group.group
                                            }
                                        });
                                    }
                                }
                            });
                        }
                    });
                }

                calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    headerToolbar: {
                        left: 'prev,next today',
                        center: 'title',
                        right: 'dayGridMonth,timeGridWeek,timeGridDay'
                    },
                    events: events,
                    eventClick: function(info) {
                        if (info.event.extendedProps.matchId) {
                            openMatchDetail(info.event.extendedProps.matchId);
                        }
                    },
                    locale: 'vi',
                    buttonText: {
                        today: 'Hôm nay',
                        month: 'Tháng',
                        week: 'Tuần',
                        day: 'Ngày'
                    }
                });

                // Render calendar when tab is shown
                if (calendarTab) {
                    calendarTab.addEventListener('shown.bs.tab', function (e) {
                        calendar.render();
                    });
                }
            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){
            const raw = '<%- encodeURIComponent(JSON.stringify(tournament.bracketData || null)) %>';
            let data = null;
            try { data = JSON.parse(decodeURIComponent(raw)); } catch(_) { data = null; }
            const ready = !!(data && data.teams && data.results && window.jQuery && $.fn && $.fn.bracket);
            function render(){ if (!ready) return; $('#bracket-container').empty().bracket({ init: data }); }
            document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(function(btn){
                btn.addEventListener('shown.bs.tab', function(e){ if (e.target.id === 'bracket-tab') render(); });
            });
            if (document.getElementById('bracket') && document.getElementById('bracket').classList.contains('show')) render();
            if (!ready) {
                const msg = (!$.fn || !$.fn.bracket) ? 'Thiếu thư viện bracket.' : 'Chưa có dữ liệu sơ đồ.';
                const el = document.getElementById('bracket-container');
                if (el && !el.innerHTML.trim()) el.innerHTML = '<p class="text-muted">' + msg + '</p>';
            }
        });
    </script>
