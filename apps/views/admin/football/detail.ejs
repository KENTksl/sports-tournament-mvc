        function finalizeMatchSilently() {
            if (!currentMatch || !tournamentData || (currentMatch.clock && currentMatch.clock.autoFinalized)) return;
            const s = getScoreAtCurrentTime();
            const data = {
                tournamentId: tournamentData._id,
                matchId: currentMatch.id,
                score1: s.s1,
                score2: s.s2,
                status: 'finished',
                lineup1: currentMatch.lineup1,
                lineup2: currentMatch.lineup2,
                events: currentMatch.events || []
            };
            currentMatch.clock.autoFinalized = true;
            fetch('/admin/football/tournament/update-match', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            }).then(res => res.json().catch(()=>({}))).then(res => {
