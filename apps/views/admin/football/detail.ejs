        function openMatchDetail(matchId) {
            currentMatchId = matchId;
            currentMatch = null;

            // Find match
            if (tournamentData.fixtures) {
                for (const group of tournamentData.fixtures) {
                    const m = group.matches.find(m => m.id === matchId);
