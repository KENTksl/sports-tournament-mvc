                            const statusCell = row.querySelector('td .badge');
                            if (statusCell) {
                                statusCell.className = 'badge bg-success';
                                statusCell.innerText = 'Hoàn thành';
                            }
                        }
                    }
                }
            }).catch(()=>{});
