    <!-- Template Javascript -->
    <script src="/static/admin/js/main.js"></script>

    <script>
        const tournamentData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(tournament)) %>'));
        const socket = typeof io !== 'undefined' ? io() : null;

        // Helper to refresh bracket
        function refreshBracket() {
            if (tournamentData.bracketData && tournamentData.bracketData.teams && tournamentData.bracketData.results && window.jQuery && $.fn && $.fn.bracket) {
                const initData = normalizeBracketDataForPlugin(tournamentData.bracketData);
                if (document.getElementById('bracket') && document.getElementById('bracket').classList.contains('active')) {
                    $('#bracket-container').empty().bracket({ init: initData });
                }
            }
        }

        function normalizeBracketDataForPlugin(bd){
            try {
                const data = JSON.parse(JSON.stringify(bd || {}));
                if (Array.isArray(data.results) && data.results.length > 0) {
                    const last = data.results[data.results.length - 1];
                    if (Array.isArray(last) && last.length === 2 && Array.isArray(last[0]) && Array.isArray(last[1])) {
                        data.results[data.results.length - 1] = [ last[0] ];
                        data.consolation = [ last[1] ];
                    }
                }
                return data;
            } catch(_) {
                return bd;
            }
        }

        // Add listener for tab switch to refresh bracket when it becomes visible
        document.addEventListener('DOMContentLoaded', function() {
            const bracketTabBtn = document.querySelector('button[data-bs-target="#bracket"]');
            if (bracketTabBtn) {
                bracketTabBtn.addEventListener('shown.bs.tab', function (event) {
                    // Force refresh when tab is shown
                    if (tournamentData.bracketData && tournamentData.bracketData.teams && tournamentData.bracketData.results && window.jQuery && $.fn && $.fn.bracket) {
                        const initData = normalizeBracketDataForPlugin(tournamentData.bracketData);
                        $('#bracket-container').empty().bracket({ init: initData });
                    }
                });
            }
        });

        // Helper to sync match score to bracket data
        function syncMatchToBracket(matchId, score1, score2) {
            if (!tournamentData.bracketData || !tournamentData.bracketData.results) return;
            
            let bm = null;
            if (tournamentData.fixtures) {
                for (const group of tournamentData.fixtures) {
                    const m = group.matches.find(m => m.id === matchId);
                    if (m && m.bracketRound !== undefined && m.bracketMatchIndex !== undefined) { bm = m; break; }
                }
            }

            if (bm) {
                const s1 = (score1 !== null && score1 !== undefined && score1 !== '') ? parseInt(score1) : null;
                const s2 = (score2 !== null && score2 !== undefined && score2 !== '') ? parseInt(score2) : null;
                
                const r = bm.bracketRound;
                const i = bm.bracketMatchIndex;

                if (tournamentData.bracketData.results[r]) {
                    if (r === tournamentData.bracketData.results.length - 1 && tournamentData.bracketData.results[r].length === 1) {
                        if (!Array.isArray(tournamentData.bracketData.results[r][0])) {
                            tournamentData.bracketData.results[r][0] = [null, null];
                        }
                        if (i === 0) {
                            tournamentData.bracketData.results[r][0] = [s1, s2];
                        } else if (i === 1) {
                            if (!Array.isArray(tournamentData.bracketData.consolation)) {
                                tournamentData.bracketData.consolation = [];
                            }
                            if (!Array.isArray(tournamentData.bracketData.consolation[0])) {
                                tournamentData.bracketData.consolation[0] = [null, null];
                            }
                            tournamentData.bracketData.consolation[0] = [s1, s2];
                        }
                    } else {
                        if (!tournamentData.bracketData.results[r][i]) {
                            tournamentData.bracketData.results[r][i] = [null, null];
                        }
                        tournamentData.bracketData.results[r][i] = [s1, s2];
                    }
                    refreshBracket();
                }
            }
        }

        if (socket) {
            socket.emit('join_tournament', tournamentData._id);
            socket.on('bracket_updated', (msg) => {
                if (msg && msg.bracketData) {
                    tournamentData.bracketData = msg.bracketData;
                    refreshBracket();
                }
            });

            socket.on('match_updated', (msg) => {
                if (!msg || !msg.matchId || !msg.payload) return;
                const { matchId, payload } = msg;
                // Update local tournamentData
                if (tournamentData.fixtures) {
                    for (const group of tournamentData.fixtures) {
                        const m = group.matches.find(m => m.id === matchId);
                        if (m) {
                            if (payload.score1 !== undefined) m.score1 = payload.score1;
                            if (payload.score2 !== undefined) m.score2 = payload.score2;
                            if (payload.lineup1 !== undefined) m.lineup1 = payload.lineup1;
                            if (payload.lineup2 !== undefined) m.lineup2 = payload.lineup2;
                            if (payload.events !== undefined) m.events = payload.events;
                            if (payload.status !== undefined) m.status = payload.status;
                            break;
                        }
                    }
                }
                // Update list row if present
                const triggerBtn = document.querySelector(`[data-match-id="${matchId}"]`);
                if (triggerBtn) {
                    const row = triggerBtn.closest('tr');
                    if (row) {
                        if (payload.score1 !== undefined && payload.score2 !== undefined) {
                            const scoreCell = row.querySelector('td.text-center');
                            if (scoreCell) {
                                const s1 = (payload.score1 === null || payload.score1 === 'null') ? '- -' : payload.score1;
                                const s2 = (payload.score2 === null || payload.score2 === 'null') ? '' : payload.score2;
                                scoreCell.innerHTML = (s1 === '- -') ? '- : -' : `${s1} : ${s2}`;
                            }
                            const statusCell = row.querySelector('td .badge');
                            if (statusCell && payload.status) {
                                if (payload.status === 'finished') {
                                    statusCell.className = 'badge bg-success';
                                    statusCell.innerText = 'Hoàn thành';
                                } else if (payload.status === 'live') {
                                    statusCell.className = 'badge bg-danger animate-pulse';
                                    statusCell.innerText = 'Đang đá (Live)';
                                } else {
                                    statusCell.className = 'badge bg-warning text-dark';
                                    statusCell.innerText = 'Sắp đá';
                                }
                            }
                        }
                    }
                }
                
                // Sync Bracket
                let s1 = payload.score1;
                let s2 = payload.score2;
                // If payload doesn't have score, we might need to look it up from tournamentData (already updated above)
                if (s1 === undefined || s2 === undefined) {
                     if (tournamentData.fixtures) {
                        for (const group of tournamentData.fixtures) {
                            const m = group.matches.find(m => m.id === matchId);
                            if (m) {
                                s1 = m.score1;
                                s2 = m.score2;
                                break;
                            }
                        }
                     }
                }
                syncMatchToBracket(matchId, s1, s2);

                // If modal is open for this match, refresh view
                if (currentMatch && currentMatch.id === matchId) {
                    Object.assign(currentMatch, payload);
                    const pitchType = tournamentData.pitchType || '7';
                    const positions = PITCH_CONFIGS[pitchType] || PITCH_CONFIGS['7'];
                    renderTeamLineup('team1', currentMatch.team1, currentMatch.lineup1 || [], positions);
                    renderTeamLineup('team2', currentMatch.team2, currentMatch.lineup2 || [], positions);
                    renderEvents();
                }
            });
        }
        let currentMatchId = null;
        let currentMatch = null;
        let editingLocked = false;
        let matchModalInstance = null;
        let penaltyInterval = null;
        let matchClockInterval = null;
        let kickoffTimeoutId = null;
        let scheduleCheckInterval = null;
